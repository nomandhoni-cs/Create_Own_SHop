{% assign all_blocks = section.blocks %}
<section class="pb-70 pt-70">
  <div class="container">
    <div class="row d-flex align-items-center">
      <div class="recommended-text-box">
        <h2 class="heading-text">{{ section.settings.heading_text }}</h2>
        <div class="btn-black">
          <span>{{ section.settings.sub_heading_text }}</span>
        </div>
      </div>
      <span class="line pt-20"> </span>
    </div>
  </div>

  <div class="card-box">
    <div class="owl-carousel owl-theme">
      {% for single_shop_block in all_blocks %}
        <div class="item shop-bg">
          <img
            src="{{ single_shop_block.settings.shop_image |  image_url: width: 400, height: 400, quality: 80, crop: true }}"
            alt=""
          >
          <div class="p-text">
            <span class="profile-img">
              <img
                src="{{single_shop_block.settings.profile_image |  image_url: width: 50, height: 50, quality: 80, crop: true }}"
                alt=""
              >
            </span>
            <h6>{{ single_shop_block.settings.shop_name }}</h6>
            <div class="btn btn-border">
              <span>VIEW SHOP</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "create-own-seller-shop",
  "settings": [
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "We wanna open you shop with co"
    },
    {
      "type": "text",
      "id": "sub_heading_text",
      "label": "Sub Heading Text",
      "default": "Become a seller"
    }
  ],
  "blocks": [
    {
      "type": "own_seller_shop",
      "name": "Create seller shop",
      "settings": [
        {
          "type": "text",
          "id": "shop_name",
          "label": "Shop Name",
          "default": "Your Shop Name"
        },
        {
          "type": "image_picker",
          "id": "shop_image",
          "label": "Shop Image"
        },
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile Image"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Create your own seller shop"
    }
  ]
}
{% endschema %}
